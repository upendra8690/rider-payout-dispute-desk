# Copy to .env. docker compose reads OPS_API_TOKEN / LLM_* / LOG_LEVEL from it;
# DATABASE_URL and PAYSWIFT_BASE_URL are set by docker-compose.yml to the container hostnames.

# --- infrastructure (used when running without Docker) ---
DATABASE_URL=postgresql+psycopg://qd:qd@localhost:5432/dispute_desk
PAYSWIFT_BASE_URL=http://localhost:8081
LOG_LEVEL=INFO

# --- ops console / ops API authentication (change this!) ---
OPS_API_TOKEN=change-me-ops-token

# --- LLM for understanding rider messages (optional) ---
# none | groq | gemini | openai | anthropic. Without a key the deterministic parser is used.
LLM_PROVIDER=none
LLM_API_KEY=
# Optional overrides. Defaults: groq llama-3.3-70b-versatile, gemini gemini-2.0-flash,
# openai gpt-4o-mini, anthropic claude-haiku-5-5. LLM_BASE_URL can point at any OpenAI-compatible server.
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=4

# --- Finance policy (defaults = the note from Finance) ---
AUTO_PAY_MAX_PER_DISPUTE=200
AUTO_PAY_MAX_PER_RIDER_PER_DAY=1
DISPUTE_WINDOW_DAYS=7

# --- latency budget: the messaging vendor retries after ~10s ---
MESSAGE_BUDGET_SECONDS=8
PAYSWIFT_ATTEMPT_TIMEOUT_SECONDS=6
